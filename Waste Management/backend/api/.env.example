# ---- Safaai Sarathi API ----
PORT=5100
NODE_ENV=development

# PostgreSQL. Fill in the password for the `postgres` role, then:
#   npm run db:push && npm run seed
# PostgreSQL 17 listens on 5432 and PostgreSQL 16 on 5433 on this machine.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@127.0.0.1:5433/waste_management?schema=public"

# Auth (plan §6)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Google OAuth 2.0 / OIDC — raw, no Firebase. Leave blank to disable the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5100/api/auth/citizen/google/callback

# Web origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5273,http://127.0.0.1:5273

# AI service (YOLOv8 classification, duplicate embeddings, fraud scoring)
AI_SERVICE_URL=http://127.0.0.1:8100

# Optional external routing solver (OSRM / OR-Tools). Empty = built-in Node solver.
ROUTING_SERVICE_URL=

# Optional Redis — Socket.io adapter, rate-limit store, OTP cache.
# Empty = in-process fallbacks (fine for a single instance).
REDIS_URL=

# File storage: local | minio | cloudinary
STORAGE_DRIVER=local

# SMTP for verification mail. Empty = links are logged to the console instead.
SMTP_URL=
MAIL_FROM="Safaai Sarathi <no-reply@safaaisarathi.local>"

# AI decision thresholds (plan §7 honesty line)
AI_CONFIDENCE_AUTO_APPROVE=0.70
AI_FRAUD_REVIEW_THRESHOLD=0.60

# Escalation timers (minutes)
ESCALATION_EMERGENCY_MINUTES=30
ESCALATION_STANDARD_MINUTES=1440

# Demo vehicle simulator — drives seeded trucks along their routes.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=2000
